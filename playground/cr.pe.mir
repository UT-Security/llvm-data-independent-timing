  bb.3 (%ir-block.10):
    successors: %bb.4(0x80000000)
  
    renamable $w8 = LDRWui $sp, 2 :: (dereferenceable load (s32) from %ir.4)
    STRWui killed renamable $w8, $sp, 3 :: (store (s32) into %ir.3)
    B %bb.4
  
