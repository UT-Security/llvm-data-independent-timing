  bb.1 (%ir-block.2):
    successors: %bb.2(0x40000000), %bb.3(0x40000000)
    liveins: $w0, $w1
  
    $sp = frame-setup SUBXri $sp, 16, 0
    STRWui killed renamable $w0, $sp, 2 :: (store (s32) into %ir.4)
    STRWui killed renamable $w1, $sp, 1 :: (store (s32) into %ir.5)
    renamable $w8 = LDRWui $sp, 2 :: (dereferenceable load (s32) from %ir.4)
    renamable $w9 = LDRWui $sp, 1 :: (dereferenceable load (s32) from %ir.5)
    dead renamable $w8 = SUBSWrr killed renamable $w8, killed renamable $w9, implicit-def $nzcv
