@@ -419,7 +420,7 @@
 
 /* {{{ Generate a hash of a given input string
 Returns lowercase hexits by default */
-PHP_FUNCTION(hash)
+static void zif_hash_body(INTERNAL_FUNCTION_PARAMETERS)
 {
 	zend_string *algo;
 	char *data;
@@ -576,7 +577,7 @@
 
 /* {{{ Generate a hash of a given input string with a key using HMAC
 Returns lowercase hexits by default */
-PHP_FUNCTION(hash_hmac)
+static void zif_hash_hmac_body(INTERNAL_FUNCTION_PARAMETERS)
 {
 	zend_string *algo;
 	char *data, *key;
@@ -1109,7 +1110,7 @@
 
 /* {{{ Compares two strings using the same time whether they're equal or not.
    A difference in length will leak */
-PHP_FUNCTION(hash_equals)
+static void zif_hash_equals_body(INTERNAL_FUNCTION_PARAMETERS)
 {
 	zval *known_zval, *user_zval;
 	int result = 0;
@@ -1715,3 +1716,27 @@
 	STANDARD_MODULE_PROPERTIES
 };
 /* }}} */
+
+/* experiment 11: the developer's bracket around hash() */
+PHP_FUNCTION(hash)
+{
+	DIT_BRACKET_ENTER();
+	zif_hash_body(INTERNAL_FUNCTION_PARAM_PASSTHRU);
+	DIT_BRACKET_LEAVE();
+}
+
+/* experiment 11: the developer's bracket around hash_hmac() */
+PHP_FUNCTION(hash_hmac)
+{
+	DIT_BRACKET_ENTER();
+	zif_hash_hmac_body(INTERNAL_FUNCTION_PARAM_PASSTHRU);
+	DIT_BRACKET_LEAVE();
+}
+
+/* experiment 11: the developer's bracket around hash_equals() */
+PHP_FUNCTION(hash_equals)
+{
+	DIT_BRACKET_ENTER();
+	zif_hash_equals_body(INTERNAL_FUNCTION_PARAM_PASSTHRU);
+	DIT_BRACKET_LEAVE();
+}
