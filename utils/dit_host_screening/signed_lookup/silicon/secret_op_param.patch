+    /* THE SECRET OP'S SIZE IS A PARAMETER, because under a flush-after switch
+     * the cost of a mode write is what has to be DISCARDED AND RE-RUN, and
+     * that is set by how far the machine has run into the operation the write
+     * brackets. 100 bytes is experiment 09's message and the default, so a
+     * build with no -D is the driver as every previous sweep ran it.
+     *
+     * At 100 bytes a chacha20-poly1305 encrypt is ~2,200 cycles under gem5 at
+     * IPC ~2, and the bracket's two writes plus its `sb` cost 42 cycles --
+     * 1.7% of the request, under the model's own layout noise. The barrier and
+     * the switch both cost what they drain, and at the AEAD entry there is
+     * almost nothing in flight: the public lane ahead of it is a serial
+     * pointer chase by construction. A larger message gives the machine
+     * something to run ahead into, so the entry switch discards more and the
+     * exit switch drains more.
+     *
+     * -DAEAD_MLEN=<bytes>. Sweep it to find where the switch's cost peaks as a
+     * FRACTION of the request: too small and there is nothing in flight, too
+     * large and the fixed drain is diluted by crypto that outgrows the window.
+     */
+#ifndef AEAD_MLEN
+#define AEAD_MLEN 100
+#endif
+
+/* WHICH AEAD IS THE SECRET LANE. -DSECRET_AES selects AES-256-GCM;
+ * chacha20-poly1305 is the default and is what every previous sweep ran.
+ *
+ * The two are not interchangeable for this measurement, and the reason is
+ * instruction-level parallelism rather than speed. A flush-after mode write
+ * costs what the machine had run ahead into and has to re-run, so the bracket
+ * only costs anything once the operation it wraps fills the window.
+ * chacha20-poly1305 is a serial ARX chain: measured under gem5 it does not
+ * fill the window until the message is about 4 KB, and by then the request is
+ * 46,000 cycles and a ~300-cycle switch is 0.6% of it. AES-GCM has
+ * independent round and GHASH work per block, so it saturates the window at a
+ * far smaller message -- which is the regime a bracket is actually visible in,
+ * and the regime experiment 14's AWS-LC rows sit in (a 16-byte seal is ~190
+ * cycles on an M4 and the bracket is 81% of it).
+ *
+ * Availability is CHECKED, not assumed: libsodium's AES-GCM needs the ARM
+ * crypto extensions and returns 0 without them, and an arm that silently ran
+ * a different primitive than it claims is worse than one that fails. */
+#ifdef SECRET_AES
+#  define SECRET_NAME        "aes256gcm"
+#  define SECRET_KEYBYTES    crypto_aead_aes256gcm_KEYBYTES
+#  define SECRET_NPUBBYTES   crypto_aead_aes256gcm_NPUBBYTES
+#  define SECRET_ABYTES      crypto_aead_aes256gcm_ABYTES
+#  define SECRET_KEYGEN      crypto_aead_aes256gcm_keygen
+#  define SECRET_ENCRYPT     crypto_aead_aes256gcm_encrypt
+#else
+#  define SECRET_NAME        "chacha20poly1305"
+#  define SECRET_KEYBYTES    crypto_aead_chacha20poly1305_ietf_KEYBYTES
+#  define SECRET_NPUBBYTES   crypto_aead_chacha20poly1305_ietf_NPUBBYTES
+#  define SECRET_ABYTES      crypto_aead_chacha20poly1305_ietf_ABYTES
+#  define SECRET_KEYGEN      crypto_aead_chacha20poly1305_ietf_keygen
+#  define SECRET_ENCRYPT     crypto_aead_chacha20poly1305_ietf_encrypt
+#endif
+    enum { AEAD_MLEN_ = AEAD_MLEN };
+    unsigned char ak[SECRET_KEYBYTES];
+    unsigned char amsg[AEAD_MLEN];
+    unsigned char act[AEAD_MLEN + SECRET_ABYTES];
+    unsigned char npub[SECRET_NPUBBYTES];
     unsigned long long actlen = 0;
-    crypto_aead_chacha20poly1305_ietf_keygen(ak);
+#ifdef SECRET_AES
+    if (!crypto_aead_aes256gcm_is_available()) {
+        fprintf(stderr, "FATAL: -DSECRET_AES but AES-256-GCM is unavailable on "
+                        "this machine; the arm would run a primitive it does "
+                        "not claim.\n");
+        return 2;
+    }
+#endif
+    SECRET_KEYGEN(ak);
