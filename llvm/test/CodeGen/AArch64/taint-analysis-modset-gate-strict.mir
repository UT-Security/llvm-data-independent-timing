# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-insert-dit %s -o - | FileCheck %s --check-prefix=DEFAULT
# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-insert-dit -taint-no-modset-gate %s -o - | FileCheck %s --check-prefix=NOGATE

# SOUNDNESS PIN for the call-site mod-set gate, which is ON by default: a callee
# whose secret does NOT arrive through its own arguments must NOT have its clobber
# suppressed. This is the shape the source condition exists for.
#
# `seeder` stores its parameter into the global @g, so its summary records
# WritesSecretToGlobal(@g) - which is deliberately NEVER gated, being per-global
# rather than a flood and the very "secret arrived through a global" case the gate
# is unsound for. `middle` calls `seeder` (passing a CONSTANT, so nothing about
# this depends on the caller), then LOADS @g and writes it through its own pointer
# parameter. `middle` therefore has a secret-writing mod-set with an EMPTY
# tainted-argument set, and its taint is non-argument-sourced: it came out of a
# global, not out of any caller.
#
# `public_caller` passes `middle` no secret. A gate that asked only "did this call
# site pass a secret?" would suppress `middle`'s clobber and leave the reload of
# %buf untainted - but the secret is real, and no caller's arguments can account
# for it. That is the unsound shape, and it occurs in libsecp256k1 (9 of 26
# suppressed sites, e.g. secp256k1_ecmult_gen_blind <-
# secp256k1_context_preallocated_create).
#
# The source condition declines to gate `middle` precisely because it has no
# tainted argument for a caller's arguments to speak for, so `public_caller` keeps
# its protection. It is unconditional - the permissive rule that would drop this
# secret is not reachable from the command line - and it measured byte-identical on
# every library screened, so it costs nothing. If this test ever reports
# `public_caller` clean, the gate has started swallowing secrets.

# Emission order: seeder, middle, public_caller.

# middle handles the secret it loaded out of @g either way.
# DEFAULT-LABEL: name: middle
# DEFAULT: MSRpstateImm4 26, 1
# NOGATE-LABEL: name: middle
# NOGATE: MSRpstateImm4 26, 1

# public_caller keeps DIT in BOTH configurations: by default because the source
# condition refuses to gate a non-argument-sourced callee, and under
# -taint-no-modset-gate because nothing is gated at all.
# DEFAULT-LABEL: name: public_caller
# DEFAULT: MSRpstateImm4 26, 1
# NOGATE-LABEL: name: public_caller
# NOGATE: MSRpstateImm4 26, 1

--- |
  target triple = "aarch64-unknown-linux-gnu"

  @g = internal global i32 0, align 4

  define void @seeder(i32 "tainted" %secret) {
  entry:
    store i32 %secret, ptr @g, align 4
    ret void
  }

  define void @middle(ptr %dst) {
  entry:
    call void @seeder(i32 0)
    %v = load i32, ptr @g, align 4
    store i32 %v, ptr %dst, align 4
    ret void
  }

  define i32 @public_caller() {
  entry:
    %buf = alloca i32, align 4
    call void @middle(ptr %buf)
    %v = load i32, ptr %buf, align 4
    ret i32 %v
  }

...
---
name:            seeder
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$w0' }
body:             |
  bb.0.entry:
    liveins: $w0

    renamable $x8 = ADRP target-flags(aarch64-page) @g
    STRWui killed renamable $w0, killed renamable $x8, target-flags(aarch64-pageoff, aarch64-nc) @g :: (store (s32) into @g)
    RET_ReallyLR

...
---
name:            middle
tracksRegLiveness: true
isSSA:           false
body:             |
  bb.0.entry:
    liveins: $x0

    $x19 = COPY $x0
    $w0 = MOVi32imm 0
    BL @seeder, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $w0
    renamable $x8 = ADRP target-flags(aarch64-page) @g
    renamable $w9 = LDRWui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-nc) @g :: (load (s32) from @g)
    STRWui killed renamable $w9, killed renamable $x19, 0 :: (store (s32) into %ir.dst)
    RET_ReallyLR

...
---
name:            public_caller
tracksRegLiveness: true
isSSA:           false
stack:
  - { id: 0, name: buf, offset: 0, size: 4, alignment: 4 }
body:             |
  bb.0.entry:
    $x0 = ADDXri %stack.0.buf, 0, 0
    BL @middle, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $x0
    renamable $w0 = LDRWui %stack.0.buf, 0 :: (load (s32) from %ir.buf)
    RET_ReallyLR implicit killed $w0

...
