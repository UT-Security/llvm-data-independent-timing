# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-regions-output=%t.regions %s -o /dev/null
# RUN: FileCheck %s --check-prefix=REGIONS --input-file=%t.regions

# Tainted runs separated by up to two clean candidate instructions in the same
# basic block are reported as one region; three clean instructions still split it.
# The gap was a flag (-taint-region-merge-gap) until the frequency-weighted
# admission test replaced it for placement; it is now a fixed constant because it
# feeds only the two region REPORTS.
#
# These regions do not drive placement. PSTATE.DIT placement partitions BLOCKS and
# prices its own merges with -taint-dit-switch-cyc / -taint-dit-dwell-per-instr,
# so a report-granularity constant cannot change what code gets protected — and
# splitting a run never changes whether any run exists, so it cannot change
# whether a function is instrumented either. See docs/design/dit-placement.md.

# %0..%4 coalesce into one region across the two clean instructions between them;
# the three clean instructions before %8 still split it off.
# REGIONS: # Region 1 (bundle_gap)
# REGIONS: %0:gpr32common = COPY $w0
# REGIONS: %1:gpr32common = COPY $w1
# REGIONS: %2:gpr32common = ADDWri %0:gpr32common, 1, 0
# REGIONS: %3:gpr32common = ADDWri %1:gpr32common, 1, 0
# REGIONS: %4:gpr32common = ADDWri %0:gpr32common, 2, 0
# REGIONS: # Region 2 (bundle_gap)
# REGIONS: %8:gpr32common = ADDWri %0:gpr32common, 3, 0
# REGIONS-NOT: # Region 3

--- |
  target triple = "aarch64-unknown-linux-gnu"

  define i32 @bundle_gap(i32 "tainted" %secret, i32 %public) {
  entry:
    %a = add i32 %secret, 1
    %b = add i32 %public, 1
    %c = add i32 %secret, 2
    %d = add i32 %public, 2
    %e = add i32 %d, 1
    %f = add i32 %e, 1
    %g = add i32 %secret, 3
    ret i32 %public
  }

...
---
name:            bundle_gap
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: gpr32common }
  - { id: 1, class: gpr32common }
  - { id: 2, class: gpr32common }
  - { id: 3, class: gpr32common }
  - { id: 4, class: gpr32common }
  - { id: 5, class: gpr32common }
  - { id: 6, class: gpr32common }
  - { id: 7, class: gpr32common }
  - { id: 8, class: gpr32common }
liveins:
  - { reg: '$w0', virtual-reg: '%0' }
  - { reg: '$w1', virtual-reg: '%1' }
body:             |
  bb.0.entry:
    liveins: $w0, $w1

    %0:gpr32common = COPY $w0
    %1:gpr32common = COPY $w1
    %2:gpr32common = ADDWri %0, 1, 0
    %3:gpr32common = ADDWri %1, 1, 0
    %4:gpr32common = ADDWri %0, 2, 0
    %5:gpr32common = ADDWri %1, 2, 0
    %6:gpr32common = ADDWri %5, 1, 0
    %7:gpr32common = ADDWri %6, 1, 0
    %8:gpr32common = ADDWri %0, 3, 0
    $w0 = COPY %1
    RET_ReallyLR implicit $w0

...
