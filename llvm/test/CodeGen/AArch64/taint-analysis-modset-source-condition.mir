# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-insert-dit %s -o - | FileCheck %s --check-prefix=DEFAULT
# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-insert-dit -taint-no-modset-gate %s -o - | FileCheck %s --check-prefix=NOGATE

# THE SOURCE CONDITION: a callee that has a tainted parameter AND obtains a secret
# from somewhere else. This is the case the earlier "does the callee name a tainted
# parameter?" proxy got wrong, and the reason FunctionMemEffects::NonArgSourced
# exists.
#
# `helper(dst, x)` does two things: it takes `x`, which `secret_caller` passes a
# secret in - so its summary DOES name a tainted parameter - and it reads a secret
# out of @g and writes it through `dst`, which has nothing to do with its
# parameters.
#
# `public_caller` passes no secret. A gate resting on the tainted-parameter proxy
# alone would suppress helper's clobber and leave the reload of %buf clean - but
# %buf really does receive @g's secret. The source condition refuses to gate,
# because helper's taint reached it through a global load, which no caller's
# arguments can account for. That refusal is unconditional: the permissive rule is
# not reachable from the command line.
#
# 26 is the PSTATE.DIT pstatefield encoding.

# Emission order: stash, helper, secret_caller, public_caller.

# DEFAULT-LABEL: name: secret_caller
# DEFAULT: MSRpstateImm4 26, 1
# DEFAULT-LABEL: name: public_caller
# DEFAULT: MSRpstateImm4 26, 1

# NOGATE-LABEL: name: secret_caller
# NOGATE: MSRpstateImm4 26, 1
# NOGATE-LABEL: name: public_caller
# NOGATE: MSRpstateImm4 26, 1

--- |
  target triple = "aarch64-unknown-linux-gnu"
  @g = internal global i32 0
  define void @stash(i32 "tainted" %s) { entry: store i32 %s, ptr @g, align 4
    ret void }
  define void @helper(ptr %dst, i32 %x) { entry: call void @stash(i32 %x)
    %v = load i32, ptr @g, align 4
    store i32 %v, ptr %dst, align 4
    ret void }
  define i32 @secret_caller(i32 "tainted" %s) { entry: %buf = alloca i32, align 4
    call void @helper(ptr %buf, i32 %s)
    %v = load i32, ptr %buf, align 4
    ret i32 %v }
  define i32 @public_caller() { entry: %buf = alloca i32, align 4
    call void @helper(ptr %buf, i32 0)
    %v = load i32, ptr %buf, align 4
    ret i32 %v }
...
---
name: stash
tracksRegLiveness: true
isSSA: false
liveins:
  - { reg: '$w0' }
body: |
  bb.0.entry:
    liveins: $w0
    renamable $x8 = ADRP target-flags(aarch64-page) @g
    STRWui killed renamable $w0, killed renamable $x8, 0 :: (store (s32) into @g)
    RET_ReallyLR
...
---
name: helper
tracksRegLiveness: true
isSSA: false
body: |
  bb.0.entry:
    liveins: $x0, $w1
    $x19 = COPY $x0
    $w0 = COPY $w1
    BL @stash, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $w0
    renamable $x8 = ADRP target-flags(aarch64-page) @g
    renamable $w9 = LDRWui killed renamable $x8, 0 :: (load (s32) from @g)
    STRWui killed renamable $w9, killed renamable $x19, 0 :: (store (s32) into %ir.dst)
    RET_ReallyLR
...
---
name: secret_caller
tracksRegLiveness: true
isSSA: false
stack:
  - { id: 0, name: buf, offset: 0, size: 4, alignment: 4 }
liveins:
  - { reg: '$w0' }
body: |
  bb.0.entry:
    liveins: $w0
    $w1 = COPY $w0
    $x0 = ADDXri %stack.0.buf, 0, 0
    BL @helper, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $x0, implicit killed $w1
    renamable $w0 = LDRWui %stack.0.buf, 0 :: (load (s32) from %ir.buf)
    RET_ReallyLR implicit killed $w0
...
---
name: public_caller
tracksRegLiveness: true
isSSA: false
stack:
  - { id: 0, name: buf, offset: 0, size: 4, alignment: 4 }
body: |
  bb.0.entry:
    $w1 = MOVi32imm 0
    $x0 = ADDXri %stack.0.buf, 0, 0
    BL @helper, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $x0, implicit killed $w1
    renamable $w0 = LDRWui %stack.0.buf, 0 :: (load (s32) from %ir.buf)
    RET_ReallyLR implicit killed $w0
...
