# REQUIRES: asserts
# RUN: llc -mtriple=aarch64 -passes='taint-analysis-transform' -debug-only=taint-analysis %s -o /dev/null 2>&1 | FileCheck %s

# An implicit-DEF must not be mistaken for a use.
#
# MachineInstr::uses() starts after the EXPLICIT defs, so it still spans implicit
# defs. On AArch64 a 32-bit result carries `implicit-def $xN`, so
# `dead $w0 = MOVi32imm 1, implicit-def $x0` has $x0 among the operands uses()
# walks. anyRegUseOfKind used to count that as reading $x0: with $x0 tainted, an
# instruction that merely OVERWRITES the register looked like it read a secret and
# re-tainted its own defs — a self-sustaining loop taint could never leave, and a
# public value materialized into w0 stayed "secret" (making a public call look
# like it passed a secret, which set ExternalMemClobbered and poisoned memory).
#
# clear_by_w_def: arg 0 tainted in $x0, then overwritten by a constant. The
# 32-bit def must CLEAR the 64-bit superregister's taint.
# CHECK: TaintAnalysis: analyzing function clear_by_w_def
# CHECK:   Marked physical register $x0 as tainted (from arg 0)
# CHECK:      clear $w0 (untainted def)
# CHECK: Total tainted regs: 0

# Positive control — the guard must not stop taint flowing through a REAL use.
# $x0 is a genuine use operand of the ADD, so the result is tainted.
# CHECK: TaintAnalysis: analyzing function keep_through_real_use
# CHECK:   Marked physical register $x0 as tainted (from arg 0)
# CHECK:      set $x8 as tainted
# CHECK: Total tainted regs: {{[1-9][0-9]*}}

--- |
  target triple = "aarch64-unknown-linux-gnu"

  define i64 @clear_by_w_def(i64 "tainted" %a) {
  entry:
    ret i64 %a
  }

  define i64 @keep_through_real_use(i64 "tainted" %a) {
  entry:
    ret i64 %a
  }
...
---
name:            clear_by_w_def
tracksRegLiveness: true
liveins:
  - { reg: '$x0' }
body:             |
  bb.0.entry:
    liveins: $x0

    dead $w0 = MOVi32imm 1, implicit-def $x0
    RET_ReallyLR implicit $x0
...
---
name:            keep_through_real_use
tracksRegLiveness: true
liveins:
  - { reg: '$x0' }
body:             |
  bb.0.entry:
    liveins: $x0

    renamable $x8 = ADDXri renamable $x0, 1, 0
    $x0 = COPY killed renamable $x8
    RET_ReallyLR implicit $x0
...
