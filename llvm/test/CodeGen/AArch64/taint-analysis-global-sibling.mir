constants:       []
machineFunctionInfo:
  hasRedZone:      false
  stackSizeZPR:    0
  stackSizePPR:    0
body:             |
  bb.0.entry:
    renamable $x8 = ADRP target-flags(aarch64-page) @chan
    renamable $x8 = LDRXui killed renamable $x8, target-flags(aarch64-pageoff, aarch64-nc) @chan :: (dereferenceable load (s64) from @chan, !tbaa !10)
    renamable $w9 = MOVi32imm 131, implicit-def $x9
    renamable $x0 = MADDXrrr killed renamable $x8, killed renamable $x9, $xzr
    RET_ReallyLR implicit $x0
...
