# REQUIRES: asserts
# RUN: llc -mtriple=aarch64 -passes='taint-analysis-transform' -debug-only=taint-analysis %s -o /dev/null 2>&1 | FileCheck %s

# A narrowed reload of a spilled secret must still see the secret.
#
# Stack cells are keyed (FrameIndex, offset, size). The READ path used to require
# an EXACT key match, so spilling 8 secret bytes with STRXui and reloading the low
# 4 with LDRWui — same slot, same offset, different size — found no cell and handed
# the secret back as PUBLIC. That is an under-taint, i.e. a leaked secret: the
# reloaded half would run outside any DIT region.
#
# The read path now tests for OVERLAP with any tainted cell of the object. The
# CLEAR path deliberately stays exact-match: widening a clear would drop taint that
# a partial public store did not actually overwrite.
#
# CHECK: TaintAnalysis: analyzing function partial_reload
# CHECK:   Marked physical register $x0 as tainted (from arg 0)
# CHECK:      taint stack cell FI=0 off=0 sz=8 (store)
# CHECK:      load from tainted stack cell FI=0 off=0
# CHECK:      set $w8 as tainted
# CHECK: Total tainted regs: {{[1-9][0-9]*}}

--- |
  target triple = "aarch64-unknown-linux-gnu"

  define i32 @partial_reload(i64 "tainted" %a) {
  entry:
    ret i32 0
  }
...
---
name:            partial_reload
tracksRegLiveness: true
liveins:
  - { reg: '$x0' }
stack:
  - { id: 0, type: spill-slot, offset: -8, size: 8, alignment: 8 }
body:             |
  bb.0.entry:
    liveins: $x0

    STRXui killed renamable $x0, %stack.0, 0 :: (store (s64) into %stack.0)
    renamable $w8 = LDRWui %stack.0, 0 :: (load (s32) from %stack.0)
    $w0 = COPY killed renamable $w8
    RET_ReallyLR implicit $w0
...
