# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-insert-dit -taint-dit-placement=function %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-insert-dit %s -o - | FileCheck %s

# AlwaysEnteredWithDIT must retract through a TAIL CALL.
#
# The bit records an ENTRY property ("DIT was already on when I was called"), but
# its consumer, calleeLeavesDITSet, needs an EXIT property ("I return with DIT
# still on") to justify dropping the caller's re-assert. Those coincide only
# because a marked function emits no clear -- and a tail call breaks it, because
# the tail call IS the function's exit and there is no instruction after it at
# which state could be restored. Control reaches the tail callee's own
# `MSR DIT, #0`, whose `ret` returns straight to OUR caller.
#
# Found by code review 2026-08-08, after the ownership rule landed. Verified
# against that build: @caller emitted
#
#   MSR DIT #1 ; MADD ; BL @worker ; MADD ; MSR DIT #0 ; RET
#
# with NO re-assert after the call, so the second MADD -- a multiply on secret
# data -- executed with PSTATE.DIT=0. Exactly the leak the whole pass exists to
# prevent, and nothing caught it: the region-placement soundness verifier models
# the call through clobbersDIT, which had also started returning false for
# @worker, so it stayed "sound" and never fell back.
#
# This is the same family as the tail-call gap in taint-analysis-tailcall.mir: a
# tail call is both isReturn() and isCall(), so it is an exit with no epilogue to
# hang state restoration on. Any reasoning about "what DIT is when this function
# returns" has to treat it separately.
#
# 26 is the PSTATE.DIT pstatefield encoding.

# @worker - internal, address-never-taken, sole call site passes a secret, so it
# would otherwise qualify. It tail-calls @sink, which is externally visible and
# therefore owns DIT and clears before returning. @worker must NOT be marked.
# The observable consequence is in @caller below.
# CHECK-LABEL: name: worker
# CHECK: MSRpstateImm4 26, 1
# CHECK: TCRETURNdi @sink

# @caller - the regression. The re-assert after `BL @worker` must be present,
# because @sink's clear is what control actually returns through.
# CHECK-LABEL: name: caller
# CHECK: MSRpstateImm4 26, 1
# CHECK: BL @worker
# CHECK-NEXT: MSRpstateImm4 26, 1
# CHECK: MSRpstateImm4 26, 0
# CHECK-NEXT: RET_ReallyLR

# @sink - control: an externally visible function still owns DIT and clears.
# CHECK-LABEL: name: sink
# CHECK: MSRpstateImm4 26, 1
# CHECK: MSRpstateImm4 26, 0
# CHECK-NEXT: RET_ReallyLR

--- |
  target triple = "aarch64-unknown-linux-gnu"

  define internal i64 @worker(i64 "tainted" %k) {
  entry:
    %r = tail call i64 @sink(i64 %k)
    ret i64 %r
  }

  define i64 @caller(i64 "tainted" %k) {
  entry:
    %a = mul i64 %k, 5
    %r = call i64 @worker(i64 %a)
    %b = mul i64 %r, 7
    ret i64 %b
  }

  define i64 @sink(i64 "tainted" %k) {
  entry:
    %r = mul i64 %k, 3
    ret i64 %r
  }
...
---
name:            worker
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$x0' }
body:             |
  bb.0.entry:
    liveins: $x0

    TCRETURNdi @sink, 0, csr_aarch64_aapcs, implicit $sp, implicit killed $x0
...
---
name:            caller
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$x0' }
body:             |
  bb.0.entry:
    liveins: $x0

    $x1 = MOVi64imm 5
    $x0 = MADDXrrr $x0, $x1, $xzr
    BL @worker, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $x0, implicit-def $x0
    $x2 = MOVi64imm 7
    $x0 = MADDXrrr $x0, $x2, $xzr
    RET_ReallyLR implicit killed $x0
...
---
name:            sink
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$x0' }
body:             |
  bb.0.entry:
    liveins: $x0

    $x1 = MOVi64imm 3
    $x0 = MADDXrrr $x0, $x1, $xzr
    RET_ReallyLR implicit killed $x0
...
