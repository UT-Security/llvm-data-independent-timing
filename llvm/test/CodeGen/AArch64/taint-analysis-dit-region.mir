# The inherit contract is pinned: this test is about a call being a Need and
# the caller holding DIT across it, which the default (callee, since
# 2026-09-05) does not do.
# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-insert-dit -taint-dit-contract=inherit -taint-dit-placement=function %s -o - | FileCheck %s --check-prefix=FUNC
# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-insert-dit -taint-dit-contract=inherit -taint-dit-loop-hoist=1 %s -o - | FileCheck %s --check-prefix=REGION

# Track B increment (a): anticipation-coarse region placement, behind
# -taint-dit-placement=region (now the default; =function is the coarse opt-in).
# The REGION run line pins -taint-dit-loop-hoist=1 to check loop coarsening. Two properties:
#
#  1. DEGENERACY (@whole): when every block anticipates a need (whole-function
#     taint), region mode is byte-identical to function granularity - MSR DIT #1
#     at entry, #0 before the return. Same CHECK pattern passes in both modes.
#
#  2. NARROWING (@narrows): a trailing clean block (bb.1's public epilogue) is
#     NOT anticipated, so region mode disables DIT at that block's ENTRY (the
#     epilogue runs with DIT off), whereas function granularity keeps DIT on
#     through the epilogue and disables only before the return. The DIFFERENCE is
#     the position of `MSR DIT, #0` relative to the epilogue's ADDWri.
#
# 26 is the PSTATE.DIT pstatefield encoding.

# @whole - identical in both modes (degeneracy):
# FUNC-LABEL: name: whole
# FUNC: MSRpstateImm4 26, 1
# FUNC: ADDWri
# FUNC: MSRpstateImm4 26, 0
# FUNC-NEXT: RET_ReallyLR
# REGION-LABEL: name: whole
# REGION: MSRpstateImm4 26, 1
# REGION: ADDWri
# REGION: MSRpstateImm4 26, 0
# REGION-NEXT: RET_ReallyLR

# @narrows bb.1 - function mode keeps DIT on THROUGH the epilogue ADDWri, disables
# before the return:
# FUNC-LABEL: name: narrows
# FUNC: bb.1
# FUNC: ADDWri
# FUNC: MSRpstateImm4 26, 0
# FUNC-NEXT: RET_ReallyLR

# @narrows bb.1 - region mode disables DIT at the epilogue's ENTRY, before its
# ADDWri (the clean epilogue is excluded from the region):
# REGION-LABEL: name: narrows
# REGION: bb.1
# REGION: MSRpstateImm4 26, 0
# REGION-NEXT: {{.*}}ADDWri

# @tailcall_secret - a secret forwarded through a TAIL call (TCRETURN, which is
# isCall && isReturn). A pre-fix region build inserted a DIT re-assert AFTER the
# terminator (invalid MIR → MachineVerifier crash). Now: DIT is enabled at entry
# and stays ON through the tail call so the (external) callee inherits it
# (Scenario B) - no MSR DIT #0 before it, and nothing after the terminator.
# REGION-LABEL: name: tailcall_secret
# REGION: MSRpstateImm4 26, 1
# REGION-NEXT: TCRETURNdi @ext
# REGION-NOT: MSRpstateImm4 26, 0
#
# Whole-function placement must reach the SAME conclusion. It did not until
# 2026-08-05: emitFunctionGranularityDIT tested isReturn() before isCall(), so
# the tail call took the return path and got MSR DIT #0 emitted before it,
# handing the secret to the callee with DIT=0. The case was already here, but
# only REGION checked it, so the suite never saw the bug.
# docs/design/dit-tailcall-gap.md
# FUNC-LABEL: name: tailcall_secret
# FUNC: MSRpstateImm4 26, 1
# FUNC-NEXT: TCRETURNdi @ext
# FUNC-NOT: MSRpstateImm4 26, 0
# The label below BOUNDS the FUNC-NOT: without a following positive directive
# it would run to end-of-file and match loop_hoist's legitimate clear.
# FUNC-LABEL: name: loop_hoist

# @loop_hoist - increment (b): a Need inside a loop, behind a clean preamble.
# Region mode leaves the preamble (bb.0, bb.1 body) DIT-OFF, HOISTS the enable to
# the loop preheader (bb.1's terminator), keeps NO enable inside the loop body
# (bb.2, so no per-iteration toggle), and disables at the loop exit (bb.3).
# Function mode would put DIT on at entry, covering the whole preamble.
# REGION-LABEL: name: loop_hoist
# REGION: bb.0
# REGION-NOT: MSRpstateImm4
# REGION: bb.1
# REGION: MSRpstateImm4 26, 1
# REGION: bb.2
# REGION-NOT: MSRpstateImm4 26, 1
# REGION: bb.3
# REGION: MSRpstateImm4 26, 0

# @multi_entry - a need-loop header (bb.3) with NO unique preheader (reached from
# two external edges bb.1, bb.2). Region mode enables DIT at the end of EACH
# external predecessor (entered once), keeps NO enable in the loop header itself
# (no per-iteration toggle), and does NOT fall back to whole-function coarse
# placement - the common multi-entry shape the review flagged.
# REGION-LABEL: name: multi_entry
# REGION: bb.1
# REGION: MSRpstateImm4 26, 1
# REGION: bb.2
# REGION: MSRpstateImm4 26, 1
# REGION: bb.3
# REGION-NOT: MSRpstateImm4 26, 1
# REGION: MSRpstateImm4 26, 0

--- |
  target triple = "aarch64-unknown-linux-gnu"

  define i32 @whole(i32 "tainted" %s) {
    ret i32 0
  }

  define i32 @narrows(i32 "tainted" %s, i32 %p) {
    ret i32 0
  }

  declare i32 @ext(i32)

  define i32 @tailcall_secret(i32 "tainted" %s) {
    ret i32 0
  }

  define i32 @loop_hoist(i32 "tainted" %s, i32 %n) {
    ret i32 0
  }

  define i32 @multi_entry(i32 "tainted" %s, i32 %c, i32 %n) {
    ret i32 0
  }

...
---
name:            whole
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$w0' }
body:             |
  bb.0:
    liveins: $w0

    renamable $w0 = ADDWri killed renamable $w0, 1, 0
    RET_ReallyLR implicit $w0

...
---
name:            narrows
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$w0' }
  - { reg: '$w1' }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $w0, $w1

    renamable $w0 = ADDWri killed renamable $w0, 1, 0
    CBZW renamable $w1, %bb.2
    B %bb.1

  bb.1:
    liveins: $w0, $w1

    renamable $w2 = ADDWri killed renamable $w1, 1, 0
    $w0 = COPY killed renamable $w2
    RET_ReallyLR implicit $w0

  bb.2:
    liveins: $w0

    RET_ReallyLR implicit $w0

...
---
name:            tailcall_secret
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$w0' }
body:             |
  bb.0:
    liveins: $w0

    TCRETURNdi @ext, 0, csr_aarch64_aapcs, implicit $sp, implicit $w0

...
---
name:            loop_hoist
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$w0' }
  - { reg: '$w1' }
body:             |
  bb.0:
    successors: %bb.1
    liveins: $w0, $w1

    renamable $w2 = ADDWri renamable $w1, 5, 0
    B %bb.1

  bb.1:
    successors: %bb.2
    liveins: $w0, $w1

    renamable $w3 = ADDWri renamable $w1, 6, 0
    B %bb.2

  bb.2:
    successors: %bb.2, %bb.3
    liveins: $w0, $w1

    renamable $w0 = ADDWri killed renamable $w0, 1, 0
    CBNZW renamable $w1, %bb.2
    B %bb.3

  bb.3:
    liveins: $w0

    RET_ReallyLR implicit $w0

...
---
name:            multi_entry
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$w0' }
  - { reg: '$w1' }
  - { reg: '$w2' }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $w0, $w1, $w2

    CBZW renamable $w1, %bb.2
    B %bb.1

  bb.1:
    successors: %bb.3
    liveins: $w0, $w2

    B %bb.3

  bb.2:
    successors: %bb.3
    liveins: $w0, $w2

    B %bb.3

  bb.3:
    successors: %bb.3, %bb.4
    liveins: $w0, $w2

    renamable $w0 = ADDWri killed renamable $w0, 1, 0
    CBNZW renamable $w2, %bb.3
    B %bb.4

  bb.4:
    liveins: $w0

    RET_ReallyLR implicit $w0

...
