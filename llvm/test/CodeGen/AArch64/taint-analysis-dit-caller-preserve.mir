# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-insert-dit -taint-dit-placement=function %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64 -enable-new-pm -run-taint-interproc -taint-insert-dit %s -o - | FileCheck %s

# Verified to FAIL against the pre-fix compiler for exactly two reasons and no
# others - the callee's clear and the caller's re-assert - with both positive
# controls already passing, which is what makes those two failures meaningful
# rather than incidental. It was committed XFAIL first, then the XFAIL removed
# together with the implementation.
#
# Both run lines share one set of checks: for a function that does not own DIT
# the region emitter is bypassed (narrowing would mean clearing DIT it did not
# set), so both policies must produce the same code here.

# An instrumented callee entered with DIT ALREADY ON must not clear it.
#
# THE RULE: only the frame that turned DIT on may turn it off. A callee entered
# with DIT set did not set it, does not own it, and must leave it alone.
#
# Today every instrumented function ends with `MSR DIT, #0` before its return,
# so a callee reached from an enclosing DIT-on region destroys its caller's
# state. The caller repairs this by re-asserting `MSR DIT, #1` after every
# non-tail call. That is correct but it makes the switch count scale with the
# CALL COUNT rather than with the number of secret regions.
#
# Measured on SQLCipher (2026-08-08): libtomcrypt's cbc_encrypt drives AES one
# 16-byte block at a time through cipher_descriptor[].ecb_encrypt, a
# function-pointer table that register_cipher() writes at run time - so the
# callee is not statically resolvable and PreservesDIT can never be proven.
# The result is 3+ mode switches per block, 1,792-4,352 per 4 KB page, which at
# ~30 cyc/switch is the same order as the encryption itself. The toggles land
# inside the crypto, which is exactly the region where DIT was already free.
#
# WHY THIS IS ALSO A SECURITY FIX, not only a cost one. Under region placement a
# callee's INTERNAL region ends clear DIT too, while the caller's secret is still
# live in the frame. The caller's re-assert only repairs the state after the call
# returns, so the exposure window sits mid-callee and nothing closes it. The
# ownership rule removes the window: a callee entered with DIT on never clears.
#
# DIRECTION OF FAILURE MATTERS. Skipping the CLEAR is fail-safe - if the callee
# was in fact entered with DIT off, it merely leaves DIT set and costs dwell.
# Skipping the SET would be fail-dangerous - a callee wrongly assumed to be
# entered DIT-on would run its secret work unprotected. So this test pins the
# clear and deliberately does NOT pin the set: @secret_worker keeps its entry
# `MSR DIT, #1` even though it is provably redundant here. Eliding that is a
# further optimization and needs a MUST analysis, which is a separate change.
#
# 26 is the PSTATE.DIT pstatefield encoding (op1=0b011, op2=0b010).

# @secret_worker - internal linkage, single call site, and that call site is
# inside @secret_caller's DIT-on region. It is therefore ALWAYS entered with DIT
# set. It must not clear on the way out. This CHECK-NOT is the regression: the
# current compiler emits `MSRpstateImm4 26, 0` immediately before RET_ReallyLR.
# CHECK-LABEL: name: secret_worker
# CHECK: MSRpstateImm4 26, 1
# CHECK-NOT: MSRpstateImm4 26, 0
# CHECK: RET_ReallyLR

# @secret_caller - the owner. It is externally visible, so it may be entered
# from public code with DIT off; it sets DIT and is responsible for clearing it
# before returning. Two things to pin:
#
#   (a) no re-assert after the call. The callee no longer clobbers DIT, so the
#       repair is dead code. This CHECK-NOT is the second regression - today a
#       `MSRpstateImm4 26, 1` follows the BL.
#   (b) it MUST still clear before its own return. This is the positive control:
#       without it, a compiler that simply never emitted `MSR DIT, #0` anywhere
#       would pass this test while leaking DIT into every caller.
# CHECK-LABEL: name: secret_caller
# CHECK: MSRpstateImm4 26, 1
# CHECK: BL @secret_worker
# CHECK-NOT: MSRpstateImm4 26, 1
# CHECK: MSRpstateImm4 26, 0
# CHECK-NEXT: RET_ReallyLR

# @exported_worker - the safety control for the ownership rule itself. Same
# shape as @secret_worker but EXTERNALLY VISIBLE, so an out-of-TU caller may
# reach it with DIT off. It does not know it is entered DIT-on, so it owns DIT
# and must still set AND clear. This is what stops "never clear" from being
# applied universally: get this wrong and an instrumented function hands DIT
# back to public code permanently.
# CHECK-LABEL: name: exported_worker
# CHECK: MSRpstateImm4 26, 1
# CHECK: MSRpstateImm4 26, 0
# CHECK-NEXT: RET_ReallyLR

--- |
  target triple = "aarch64-unknown-linux-gnu"

  define internal i64 @secret_worker(i64 "tainted" %k) {
  entry:
    %r = mul i64 %k, 3
    ret i64 %r
  }

  define i64 @secret_caller(i64 "tainted" %k) {
  entry:
    %a = mul i64 %k, 5
    %r = call i64 @secret_worker(i64 %a)
    %b = mul i64 %r, 7
    ret i64 %b
  }

  define i64 @exported_worker(i64 "tainted" %k) {
  entry:
    %r = mul i64 %k, 3
    ret i64 %r
  }
...
---
name:            secret_worker
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$x0' }
body:             |
  bb.0.entry:
    liveins: $x0

    $x1 = MOVi64imm 3
    $x0 = MADDXrrr $x0, $x1, $xzr
    RET_ReallyLR implicit killed $x0
...
---
name:            secret_caller
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$x0' }
body:             |
  bb.0.entry:
    liveins: $x0

    $x1 = MOVi64imm 5
    $x0 = MADDXrrr $x0, $x1, $xzr
    BL @secret_worker, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit killed $x0, implicit-def $x0
    $x1 = MOVi64imm 7
    $x0 = MADDXrrr $x0, $x1, $xzr
    RET_ReallyLR implicit killed $x0
...
---
name:            exported_worker
tracksRegLiveness: true
isSSA:           false
liveins:
  - { reg: '$x0' }
body:             |
  bb.0.entry:
    liveins: $x0

    $x1 = MOVi64imm 3
    $x0 = MADDXrrr $x0, $x1, $xzr
    RET_ReallyLR implicit killed $x0
...
