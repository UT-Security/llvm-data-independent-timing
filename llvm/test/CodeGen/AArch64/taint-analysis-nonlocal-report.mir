# RUN: llc -mtriple=aarch64-unknown-linux-gnu -enable-new-pm -run-taint-interproc \
# RUN:     -taint-insert-dit -taint-dit-placement=function \
# RUN:     -taint-nonlocal-report=%t %s -o /dev/null
# RUN: FileCheck %s < %t

# The DIT ABI (docs/design/dit-abi.md §1) obliges an instrumented callee to return
# PSTATE.DIT exactly as it found it. Some exits destroy the frame WITHOUT running
# the epilogue, so the restore never executes and the obligation degrades to the
# weaker guarantee, d_out >= d_in.
#
# All of them leave DIT SET, so none can strip a caller's protection and the
# residual is dwell, not exposure. None is repairable from inside the function
# either -- SME's answer (mandate a value at handler entry, teach libunwind to
# enforce it) is blocked upstream by abi-aa #394, still open. So they are
# REPORTED, which turns a caveat in a design document into a list an auditor can
# work through.
#
# setjmp: longjmp restores no PSTATE bit -- DIT is not in jmp_buf -- so it skips
# the epilogue of every frame it unwinds past. Detected via `returns_twice`.
# CHECK-DAG: NONLOCAL setjmp callee=my_setjmp caller=jumper
#
# musttail: guaranteed TCO is a correctness requirement, so it bypasses the
# TU-wide -fno-optimize-sibling-calls that -ftaint-harden turns on. A tail call is
# BOTH isReturn() and isCall(), and there is no instruction after it at which DIT
# could be restored.
# CHECK-DAG: NONLOCAL musttail callee=sink caller=tailer
#
# `plain` calls the same external through an ordinary call, reaches its epilogue,
# and restores there. It must NOT be reported.
# CHECK-NOT: caller=plain

# This MIR is generated (clang -O1 -S -emit-llvm, then llc -stop-after=prologepilog)
# rather than hand-written. Hand-written call-bearing MIR silently loses taint:
# an earlier draft of this test had two BLs in a block and the analysis reported
# zero tainted instructions, while the identical C compiled end-to-end reports
# four. Generate the MIR.

--- |
  ; ModuleID = 'nl.ll'
  source_filename = "nl.c"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
  target triple = "aarch64-unknown-linux-gnu"
  
  @g_buf = external local_unnamed_addr global ptr, align 8
  
  ; Function Attrs: nounwind uwtable
  define dso_local i64 @jumper(i64 noundef "tainted" %secret) local_unnamed_addr #0 {
  entry:
    %call = call i64 @sink(i64 noundef %secret) #3
    %0 = load ptr, ptr @g_buf, align 8, !tbaa !10
    %call1 = call i32 @my_setjmp(ptr noundef %0) #4
    %tobool.not = icmp eq i32 %call1, 0
    %call. = select i1 %tobool.not, i64 %call, i64 0
    ret i64 %call.
  }
  
  declare i64 @sink(i64 noundef) local_unnamed_addr #1
  
  ; Function Attrs: returns_twice
  declare i32 @my_setjmp(ptr noundef) local_unnamed_addr #2
  
  ; Function Attrs: nounwind uwtable
  define dso_local i64 @tailer(i64 noundef "tainted" %secret) local_unnamed_addr #0 {
  entry:
    %call = musttail call i64 @sink(i64 noundef %secret) #3
    ret i64 %call
  }
  
  ; Function Attrs: nounwind uwtable
  define dso_local i64 @plain(i64 noundef "tainted" %secret) local_unnamed_addr #0 {
  entry:
    %call = tail call i64 @sink(i64 noundef %secret) #3
    %add = add i64 %call, 1
    ret i64 %add
  }
  
  attributes #0 = { nounwind uwtable "frame-pointer"="non-leaf-no-reserve" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="generic" "target-features"="+fp-armv8,+neon,+v8a,-fmv" }
  attributes #1 = { "frame-pointer"="non-leaf-no-reserve" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="generic" "target-features"="+fp-armv8,+neon,+v8a,-fmv" }
  attributes #2 = { returns_twice "frame-pointer"="non-leaf-no-reserve" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="generic" "target-features"="+fp-armv8,+neon,+v8a,-fmv" }
  attributes #3 = { nounwind }
  attributes #4 = { nounwind returns_twice }
  
  !llvm.module.flags = !{!0, !1, !2, !3, !4}
  !llvm.ident = !{!5}
  !llvm.errno.tbaa = !{!6}
  
  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 8, !"PIC Level", i32 2}
  !2 = !{i32 7, !"PIE Level", i32 2}
  !3 = !{i32 7, !"uwtable", i32 2}
  !4 = !{i32 7, !"frame-pointer", i32 4}
  !5 = !{!"clang version 23.0.0git (https://github.com/UT-Security/llvm-data-independent-timing.git 4fb7600db532542121217fc56634ab3db86d87a6)"}
  !6 = !{!7, !7, i64 0}
  !7 = !{!"int", !8, i64 0}
  !8 = !{!"omnipotent char", !9, i64 0}
  !9 = !{!"Simple C/C++ TBAA"}
  !10 = !{!11, !11, i64 0}
  !11 = !{!"any pointer", !8, i64 0}
...
---
name:            jumper
alignment:       4
exposesReturnsTwice: true
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: true
registers:       []
liveins:
  - { reg: '$x0', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       32
  offsetAdjustment: 0
  maxAlignment:    16
  adjustsStack:    true
  hasCalls:        true
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: true
  localFrameSize:  0
fixedStack:      []
stack:
  - { id: 0, name: '', type: spill-slot, offset: -16, size: 8, alignment: 16, 
      stack-id: default, callee-saved-register: '$x19', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 1, name: '', type: spill-slot, offset: -24, size: 8, alignment: 8, 
      stack-id: default, callee-saved-register: '$lr', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 2, name: '', type: spill-slot, offset: -32, size: 8, alignment: 8, 
      stack-id: default, callee-saved-register: '$fp', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  hasRedZone:      false
  stackSizeZPR:    0
  stackSizePPR:    0
  hasStackFrame:   true
body:             |
  bb.0.entry:
    liveins: $x0, $lr, $x19
  
    early-clobber $sp = frame-setup STPXpre killed $fp, killed $lr, $sp, -4 :: (store (s64) into %stack.2), (store (s64) into %stack.1)
    frame-setup CFI_INSTRUCTION def_cfa_offset 32
    frame-setup STRXui killed $x19, $sp, 2 :: (store (s64) into %stack.0)
    $fp = frame-setup ADDXri $sp, 0, 0
    frame-setup CFI_INSTRUCTION def_cfa $w29, 32
    frame-setup CFI_INSTRUCTION offset $w19, -16
    frame-setup CFI_INSTRUCTION offset $w30, -24
    frame-setup CFI_INSTRUCTION offset $w29, -32
    BL @sink, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit $x0, implicit-def $sp, implicit-def $x0
    renamable $x8 = LOADgot target-flags(aarch64-got) @g_buf
    renamable $x8 = LDRXui killed renamable $x8, 0 :: (dereferenceable load (s64) from @g_buf, !tbaa !10)
    renamable $x19 = COPY $x0
    $x0 = COPY killed renamable $x8
    BL @my_setjmp, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit $x0, implicit-def $sp, implicit-def $w0
    dead $wzr = SUBSWri killed renamable $w0, 0, 0, implicit-def $nzcv
    renamable $x0 = CSELXr killed renamable $x19, $xzr, 0, implicit killed $nzcv
    frame-destroy CFI_INSTRUCTION def_cfa $wsp, 32
    $x19 = frame-destroy LDRXui $sp, 2 :: (load (s64) from %stack.0)
    early-clobber $sp, $fp, $lr = frame-destroy LDPXpost $sp, 4 :: (load (s64) from %stack.2), (load (s64) from %stack.1)
    frame-destroy CFI_INSTRUCTION def_cfa_offset 0
    frame-destroy CFI_INSTRUCTION restore $w19
    frame-destroy CFI_INSTRUCTION restore $w30
    frame-destroy CFI_INSTRUCTION restore $w29
    RET_ReallyLR implicit $x0
...
---
name:            tailer
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: true
registers:       []
liveins:
  - { reg: '$x0', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     true
  isCalleeSavedInfoValid: true
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  hasRedZone:      false
  stackSizeZPR:    0
  stackSizePPR:    0
body:             |
  bb.0.entry:
    liveins: $x0
  
    TCRETURNdi @sink, 0, csr_aarch64_aapcs, implicit $sp, implicit $x0
...
---
name:            plain
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: true
registers:       []
liveins:
  - { reg: '$x0', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       16
  offsetAdjustment: 0
  maxAlignment:    8
  adjustsStack:    true
  hasCalls:        true
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: true
  localFrameSize:  0
fixedStack:      []
stack:
  - { id: 0, name: '', type: spill-slot, offset: -8, size: 8, alignment: 8, 
      stack-id: default, callee-saved-register: '$lr', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 1, name: '', type: spill-slot, offset: -16, size: 8, alignment: 8, 
      stack-id: default, callee-saved-register: '$fp', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  hasRedZone:      false
  stackSizeZPR:    0
  stackSizePPR:    0
  hasStackFrame:   true
body:             |
  bb.0.entry:
    liveins: $x0, $lr
  
    early-clobber $sp = frame-setup STPXpre killed $fp, killed $lr, $sp, -2 :: (store (s64) into %stack.1), (store (s64) into %stack.0)
    frame-setup CFI_INSTRUCTION def_cfa_offset 16
    $fp = frame-setup ADDXri $sp, 0, 0
    frame-setup CFI_INSTRUCTION def_cfa $w29, 16
    frame-setup CFI_INSTRUCTION offset $w30, -8
    frame-setup CFI_INSTRUCTION offset $w29, -16
    BL @sink, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit $x0, implicit-def $sp, implicit-def $x0
    $x0 = ADDXri killed renamable $x0, 1, 0
    frame-destroy CFI_INSTRUCTION def_cfa $wsp, 16
    early-clobber $sp, $fp, $lr = frame-destroy LDPXpost $sp, 2 :: (load (s64) from %stack.1), (load (s64) from %stack.0)
    frame-destroy CFI_INSTRUCTION def_cfa_offset 0
    frame-destroy CFI_INSTRUCTION restore $w30
    frame-destroy CFI_INSTRUCTION restore $w29
    RET_ReallyLR implicit $x0
...
